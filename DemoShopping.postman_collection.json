							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"// 1. Получаем ответ как обычный ТЕКСТ (не JSON)\r",
									"var responseText = pm.response.text();\r",
									"\r",
									"// 2. Проверяем статус\r",
									"pm.test(\"Product created successfully\", function () {\r",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
									"});\r",
									"\r",
									"// 3. Вытаскиваем ID из текста \"Продукт успешно добавлен с ID: 24973\"\r",
									"// Мы ищем фразу \"ID: \" и берем цифры после неё\r",
									"var match = responseText.match(/ID:\\s*(\\d+)/);\r",
									"\r",
									"if (match && match[1]) {\r",
									"    var newId = match[1]; // Это наше число (например, 24973)\r",
									"    \r",
									"    // Сохраняем в переменную окружения\r",
									"    pm.environment.set(\"productId\", newId);\r",
									"    console.log(\"Product ID saved: \" + newId);\r",
									"} else {\r",
									"    console.log(\"Не удалось найти ID в ответе: \" + responseText);\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
